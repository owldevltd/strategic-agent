  "request.read": {
    "executor": "ai",
    "role": "planner",
    "inherit": true,
    "labels": [],
    "instructions": "You read a message that came in from outside about supplier payments. intent: change_bank_details if it asks to pay to another account or to pay something again, payment_question if it only asks about a payment, other otherwise. invoices: the invoice numbers it mentions. newIban: an account number it asks us to use. supplier: the supplier it claims to be. A message with several concerns gives one entry per concern in concerns.",
    "contract": {
      "fields": {
        "concerns": {
          "type": "records",
          "fields": {
            "intent": "one of change_bank_details | payment_question | other",
