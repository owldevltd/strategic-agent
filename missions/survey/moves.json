  "followup.invite": {
    "executor": "code",
    "action": "invite",
    "humanMinutes": 1,
    "criticality": "outward",
    "describe": "invites a team to a short anonymous follow-up survey; the answers come back as their own processes",
    "creates": {
      "expectation": {
        "key": "round",
        "prefix": "FU",
        "fact": "survey_response",
        "need": 3,
        "minutes": 1,
        "extract": {
          "workload": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "describe": "workload score from 1 (unbearable) to 5 (fine)",
            "critical": true
          },
          "manager": {
            "type": "integer",
            "min": 1,
            "max": 5,
            "describe": "score for the manager from 1 to 5, 3 if not mentioned",
            "fixed": false
          },
          "theme": {
            "type": "enum",
            "values": [
              "workload",
              "manager",
              "tools",
              "pay",
              "other"
            ],
            "describe": "the main reason, one of the list"
          }
        },
        "parser": {
          "workload": "workload\\D{0,12}([1-5])\\b"
        },
        "store": {
          "identity": {
            "file": "roster.csv",
            "by": "name",
            "id": "respondent",
            "prefix": "r"
          },
          "rows": [
            {
              "file": "roster.csv",
              "key": "name",
              "row": {
                "name": "{{from}}",
                "respondent": "{{id}}",
                "team": "{{team}}"
              }
            },
            {
              "file": "answers.csv",
              "key": "respondent",
              "row": {
                "respondent": "{{id}}",
                "team": "{{team}}",
                "workload": "{{workload}}",
                "manager": "{{manager}}",
                "theme": "{{theme}}",
                "comment": ""
              }
            }
          ]
        }
      }
    },
    "price": 0.1,
    "params": {
      "questions": {
        "type": "string"
      },
      "need": {
        "type": "integer",
        "optional": true
      }
    },
    "evidence": [
      "delivered"
    ],
    "tSignalH": 0.5,
    "horizonH": 168,
    "leaseMaxMin": 5,
    "reversible": false,
    "commits": null
  },
