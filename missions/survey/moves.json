  "analysis.write": {
    "executor": "ai",
    "role": "coder",
    "labels": [],
    "inherit": true,
    "describe": "the agent writes its own analysis code for the answers of a group; it never sees the answers",
    "instructions": "Write Python 3 code that analyses survey answers. The variable rows is a list of dicts with the keys team, workload (1 to 5), manager (1 to 5) and theme (a short category such as workload, manager, tools or growth). Set result to a dict with exactly these keys: workload (the mean workload, rounded to 2 decimals), manager (the mean manager score, rounded to 2 decimals) and themes (a dict from theme to the number of answers with it). Use no imports, no files and no printing. Answer with the code in the field code.",
    "contract": {
