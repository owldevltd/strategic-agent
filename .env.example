# Copy to .env and fill in. The processes read these from the environment; .env is only a fallback.

# Vultr Serverless Inference (OpenAI-compatible). Without a key and a model the core uses a deterministic stub.
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
# Pick a model from GET $LLM_BASE_URL/models.
LLM_MODEL=
# A model per role where one does better than the default, e.g. a reasoning model for the agent's code:
# LLM_MODELS=coder=deepseek-v4.1-flash-1017
# How long a reasoning model may think (reasoning_effort: low, medium, high), for every role or per role. Unset, a
# reasoning model may think its whole token limit away on a large answer (a file of code) and answer nothing:
# LLM_EFFORT=coder=medium
# Client timeout of a model call in seconds; shorter than the lease of a model move (A2).
# LLM_TIMEOUT=150

# Vultr account API key, only for infra/ (creating the VM). Never needed by the app.
VULTR_API_KEY=

# Where the two processes listen. The browser talks to the gate directly for confirmations and approvals.
# CORE_HOST=127.0.0.1
CORE_PORT=8090
# GATE_HOST=127.0.0.1
GATE_PORT=8091
# Where the core reaches the gate, and where the browser does (behind one host, e.g. /gate).
# GATE_URL=http://127.0.0.1:8091
# GATE_PUBLIC_URL=https://gate.example.com
# The origins whose page may call the gate from another origin, separated by commas. Default: the core's own page.
# GATE_UI_ORIGIN=https://office.example.com

# The secrets (SECURITY.md). Empty in development means open; infra/deploy.sh sets the pin and the token on the VM.
# Pin a person enters at the gate to confirm goals, approve actions and settle unclear ones. The core never knows it.
GATE_OPERATOR_PIN=
# The core's token at the gate (both processes need the same one, at least 24 characters).
# GATE_CORE_TOKEN=
# Pin for the core's board: missions, tasks, answers, abort, the logs. Unset: the board is open (simulated data only).
# CORE_BOARD_PIN=
# Token of the inbound channel (a mail bridge posting to /api/missions/:id/messages). Unset: the channel is off.
# INBOUND_TOKEN=
# Key that signs the agent's lessons; unset, a key file next to the databases is made once.
# MEMORY_KEY=

# Whose deliveries "exactly once" and "no difference" count: "gate" (every goal at this gate, the default) or "goal"
# (only the goal's own tree). infra/deploy.sh sets "goal" for the public demo, where every run is a simulated week on a
# fresh copy of the data. Only the gate's environment has it; the core cannot change it.
# GATE_LEDGER_SCOPE=gate

# Where your missions live (folders relative to this one, separated by commas), and your base setup (soft rules,
# capacity of people, time zone).
# AGENCY_MISSIONS=missions
# AGENCY_BASE=catalog/base.json
# Days the copy of a finished run's data is kept.
# VAULT_RETENTION_DAYS=30

# Sandbox: "docker" in production (isolated); "process" for development only (not isolated).
SANDBOX_RUNTIME=process
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=10
# SANDBOX_DOCKER_RUNTIME=runsc

# Buffer after a deadline in minutes; after deadline plus buffer nothing new leaves the gate.
BUFFER_MINUTES=5
# Maximum depth of child tasks.
MAX_DEPTH=5
# How often a running move reports that it is alive, in milliseconds (A1).
# LEASE_BEAT_MS=15000

# Databases (core.db, gate.db) and working files.
# STORAGE_DIR=./storage

# A folder outside this repository with overrides.json, mapping class names to replacement files.
# AGENCY_OVERRIDES=
# The gate's own channels (mail, bank, ERP): a JSON file that maps each channel's class to the actions it delivers
# (docs/missions.md, "Channels"). Unset: every action goes into the local outbox. The gate's environment only.
# AGENCY_CHANNELS=

# The simulated colleagues answer this many times faster than in real time.
# WORLD_SPEED=1

# Let the agent propose what the gate checks against (a new action, a master-data value for one kind of task); the
# operator decides at the gate. Set it for the core and the gate alike. Off by default.
# AGENCY_PROPOSALS=1

# The demo's extras: the neighbour office without a gate, its counters, the canned messages, the escape test.
# AGENCY_DEMO=1
# Public demo: one run per mission at a time, and limits per visitor (infra/deploy.sh sets it on the VM). The core
# refuses to start with it unless the sandbox is isolated (SANDBOX_RUNTIME=docker).
# PUBLIC_DEMO=1
# Optional password in front of the public demo (infra/deploy.sh puts it into Caddy).
# DEMO_USER=
# DEMO_PASSWORD=
