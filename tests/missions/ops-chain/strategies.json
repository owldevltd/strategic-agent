  {
    "id": "restart-checkout",
    "serves": "items_resolved",
    "fits": {
      "items": "^checkout$"
    },
    "class": "direct",
    "price": 1,
    "startCurve": {
      "p0": 0.9,
      "tauH": 1
    },
    "tSignalH": null,
    "describe": "inspect checkout, then have it restarted",
    "steps": [
      {
        "move": "ops.inspect",
        "params": {
          "service": "checkout"
        },
        "as": "state"
      },
      {
        "move": "restart.checkout",
        "from": "state",
        "params": {
          "service": "checkout"
        },
        "target": "ops"
      }
    ]
