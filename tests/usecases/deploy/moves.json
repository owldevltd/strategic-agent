    "humanMinutes": 2,
    "describe": "deploys the version to a share of the traffic; the monitoring reports its error rate",
    "creates": {
      "expectation": {
        "key": "ref",
        "prefix": "REL",
        "fact": "canary_report",
        "need": 2,
        "minutes": 15,
        "extract": {
          "minute": {
            "type": "integer",
            "min": 0,
            "max": 120,
            "describe": "how many minutes after the start of the canary the report is",
            "critical": true
          },
          "rate": {
            "type": "number",
            "min": 0,
            "max": 100,
            "describe": "the error rate of the canary in percent",
            "fixed": false
          }
        },
        "parser": {
          "minute": "after (\\d+) minutes"
        },
        "store": {
          "rows": [
            {
              "file": "metrics.csv",
              "key": "minute",
              "row": {
                "minute": "{{minute}}",
                "rate": "{{rate}}"
              }
            }
          ]
        },
        "each": "minute"
      }
    }
  },
