[
  {
    "id": "confirm-found-payment",
    "kind": "request",
    "serves": "report_delivered",
    "intents": [
      "paid_claim"
    ],
    "class": [
      "direct"
    ],
    "price": 0.3,
    "startCurve": {
      "p0": 0.8,
      "tauH": 2
    },
    "tSignalH": null,
    "describe": "trusted code checks the claimed payment against the bank statement; found, the customer is thanked and the invoice counts as paid",
    "steps": [
      {
        "move": "claim.check",
        "params": {
          "invoice": "{{invoices|first}}",
          "customer": "{{from}}"
        },
        "as": "claim"
      },
      {
        "move": "reply.compose",
        "from": [
          "claim"
        ],
        "params": {
          "kind": "payment_found",
          "customer": "{{from}}",
          "invoice": "{{invoices|first}}"
        },
        "as": "answer"
      },
      {
        "move": "reply.send",
        "from": "answer",
        "target": "{{from}}"
      }
    ]
  },
