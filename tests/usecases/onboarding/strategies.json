          "document": "{{items|first}}",
          "purpose": "reminder"
        },
        "as": "letter"
      },
      {
        "move": "tax.remind",
        "from": "letter",
        "params": {
          "document": "{{items|first}}"
        },
        "target": "{{items|subject}}",
        "as": "reminded"
      },
      {
