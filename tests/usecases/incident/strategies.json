    "describe": "look at the disk, rotate and compress the log that fills it, wait for the monitoring, tell on-call",
    "steps": [
      {
        "move": "disk.inspect",
        "as": "disk"
      },
      {
        "move": "disk.diagnose",
        "from": [
          "disk"
        ],
        "as": "plan"
      },
      {
        "move": "logs.rotate",
        "from": "plan",
        "target": "db-01",
        "as": "rotated"
      },
      {
        "move": "ops.wait",
        "for": "rotated"
      },
      {
        "move": "oncall.note",
        "from": [
          "disk",
          "plan"
        ],
        "as": "note"
      },
      {
        "move": "report.send",
        "from": "note",
        "target": "oncall"
      },
      {
        "move": "person.confirm",
        "params": {
          "criterion": "k1",
          "role": "on-call",
          "question": "Is the disk of db-01 below 80 % and is the database up?"
        }
      }
    ]
  },
